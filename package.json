{
  "name": "trace-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Keep the reasoning behind your engineering decisions.",
  "license": "MIT",
  "engines": {
    "node": ">=24.14 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && node --check restore.js && node --check public/app.js",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "prettier": "3.6.2"
  }
}
